[Unit]
Description=Agal One IoT Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/agal-one-agent/venv/bin/agal-one-agent --config /etc/agal-one-agent/config.yaml
Restart=always
RestartSec=10
User=root
WorkingDirectory=/opt/agal-one-agent
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
