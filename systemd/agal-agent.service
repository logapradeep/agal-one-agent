[Unit]
Description=Menvayal IoT Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/agal-agent/venv/bin/agal-agent --config /etc/agal-agent/config.yaml
Restart=always
RestartSec=10
User=root
WorkingDirectory=/opt/agal-agent
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
